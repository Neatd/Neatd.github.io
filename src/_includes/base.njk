<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#27664f">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ page.url | absolute(site.url) }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if '/posts/' in page.url and page.url != '/posts/' %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ page.url | absolute(site.url) }}">
  <meta property="og:locale" content="ko_KR">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
  <script defer src="/assets/blog.js"></script>
</head>
<body>
  <a href="#main" class="skip">본문으로 건너뛰기</a>
  <header class="header">
    <div class="wrap header-inner">
      <a class="brand" href="/" aria-label="{{ site.title }} 홈">
        <span class="mark" aria-hidden="true">s.</span>{{ site.title }}
      </a>
      <nav aria-label="주 메뉴">
        <a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>홈</a>
        <a href="/posts/" {% if '/posts/' in page.url %}aria-current="page"{% endif %}>글 목록</a>
        <a href="/tags/" {% if page.url == '/tags/' %}aria-current="page"{% endif %}>태그</a>
        <a href="/about/" {% if page.url == '/about/' %}aria-current="page"{% endif %}>소개</a>
      </nav>
      <button class="theme" type="button" aria-label="어두운 화면으로 전환" aria-pressed="false" hidden>◐</button>
    </div>
  </header>
  <main id="main" class="wrap">{{ content | safe }}</main>
  <footer class="footer wrap">
    <div>
      <a href="/" class="footer-title">{{ site.title }}</a>
      <p></p> <!-- 블로그 맨 밑에 한줄 넣을 수 있는 곳 -->
      <small>© {{ site.year }} {{ site.author }}</small>
    </div>
    <div class="footer-links">
      <a href="/feed.xml">RSS ↗</a>
      {% if site.github %}
        <a href="{{ site.github }}">GitHub ↗</a>
      {% endif %}
      {% if site.email %}
        <a href="mailto:{{ site.email }}">이메일 ↗</a>
      {% endif %}
      <a href="/about/">소개 ↗</a>
    </div>
  </footer>
</body>
</html>