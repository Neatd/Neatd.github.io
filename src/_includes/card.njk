<article class="card" data-post data-title="{{ post.data.title }}" data-description="{{ post.data.description }}" data-topics="{{ post.data.topics | json }}">
  <div class="card-top"><span class="eyebrow">{{ post.data.category or '개발 기록' }}</span><span aria-hidden="true">↗</span></div>
  <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  <p>{{ post.data.description }}</p>
  <div class="card-bottom"><div class="tags">{% for topic in post.data.topics %}<a href="/tags/?tag={{ topic | urlencode }}" class="tag">{{ topic }}</a>{% endfor %}</div><div class="meta"><time datetime="{{ post.date | iso }}">{{ post.date | dateKo }}</time><span>·</span><span>{{ post.templateContent | readTime }}분 읽기</span></div></div>
</article>
